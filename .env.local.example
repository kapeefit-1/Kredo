# Copy this file to .env.local and fill in your real Supabase project values.
# .env.local is already git-ignored — never commit real keys.
# Find these in your Supabase dashboard: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by scripts/provision-users.mjs and any server-side admin action.
# Never expose this to the browser — do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_api_key
OVERDUE_REPORT_FROM=KREDO Growth Engine <reports@your-verified-domain.com>
# Optional comma-separated override. Otherwise active CEO, COO and HR work emails are used.
OVERDUE_REPORT_RECIPIENTS=

# Local QA only. Never enable this in a public or production deployment.
KREDO_TEST_PASSWORDLESS_LOGIN=false

# Server-only. Powers the K-CRED assistant chat (app/api/assistant/route.ts). Get a key at
# platform.openai.com -> API keys. Never prefix it with NEXT_PUBLIC_ — it must stay server-side.
OPENAI_API_KEY=your-openai-api-key

# Server-only. Authorises the Vercel cron jobs in vercel.json. Vercel sends this automatically as
# "Authorization: Bearer <CRON_SECRET>"; set the same value in the Vercel project settings.
CRON_SECRET=a-long-random-string

# Consultation sheet sync (app/api/cron/consultation-sync). Reads the "Consultation Record" tab of
# the sales working doc into Supabase every two hours. Setup:
#   1. Google Cloud console -> create a service account -> enable the Google Sheets API.
#   2. Create a JSON key for it; the two values below come out of that file.
#   3. Share the spreadsheet with the service account's email as a VIEWER. The sync is read-only
#      and must stay that way — nothing in the CRM writes back to the sheet.
# Keep the private key on one line with literal \n escapes, exactly as the JSON key file has it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=consultation-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
CONSULTATION_SHEET_ID=1TVYa2UMtK8JIAinIBfhIlo_AkaOUlYZHtkJqzj7Fwos
# Optional. Defaults to the tab below; set it if the tab is ever renamed.
CONSULTATION_SHEET_TAB=Consultation Record - AP+TA+SS
